# Port on escolta el servidor Express
PORT=3000
# Connexió a MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce
# Clau secreta per signar i verificar els access tokens (genera'n una de llarga i aleatòria)
JWT_SECRET=change_me_with_a_long_random_string
# Opcional: si existeix, s'usa per als access tokens en lloc de JWT_SECRET
# JWT_ACCESS_SECRET=change_me_with_another_long_random_string
# Clau específica per als refresh tokens (recomanat: diferent de JWT_SECRET)
JWT_REFRESH_SECRET=change_me_with_another_long_random_string
# Durada de l'access token: curt per limitar el risc si es roba
JWT_ACCESS_EXPIRES_IN=15m
# Durada del refresh token: més llarg per mantenir la sessió
JWT_REFRESH_EXPIRES_IN=7d
