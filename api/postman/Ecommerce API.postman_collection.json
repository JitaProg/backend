        {
          "name": "Login Usuari",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Retorna accessToken i refreshToken\", () => {",
                  "    pm.expect(body.data.accessToken).to.be.a(\"string\");",
                  "    pm.expect(body.data.refreshToken).to.be.a(\"string\");",
                  "    pm.expect(body.data.token).to.eql(body.data.accessToken);",
                  "});",
                  "pm.collectionVariables.set(\"accessToken\", body.data.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", body.data.refreshToken);",
                  "pm.collectionVariables.set(\"token\", body.data.accessToken);"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"joan@example.com\",\r\n  \"password\": \"Password123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            }
          },
          "response": []
        },
