    {
      "name": "Users",
      "item": [
        {
          "name": "Crear Usuari",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", () => {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "pm.test(\"Response is JSON\", () => {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "pm.test(\"No exposa passwordHash\", () => {\r",
                  "    const response = pm.response.json();\r",
                  "    const obj = response.data || response;\r",
                  "    if (Array.isArray(obj)) {\r",
                  "        obj.forEach(item => pm.expect(item).to.not.have.property(\"password_hash\"));\r",
                  "    } else {\r",
                  "        pm.expect(obj).to.not.have.property(\"password_hash\");\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
