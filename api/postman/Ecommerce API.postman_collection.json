        {
          "name": "Reutilitzar Refresh Token (rebuig)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401\", () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test(\"Detecta la reutilització i revoca la família\", () => {",
                  "    pm.expect(body.error.code).to.eql(\"REFRESH_TOKEN_REUSED\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
