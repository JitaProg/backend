        {
          "name": "Registrar Usuari",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"No exposa password_hash\", () => {",
                  "    pm.expect(pm.response.json().data).to.not.have.property(\"password_hash\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"nom\": \"Joan\",\r\n  \"cognoms\": \"Pérez\",\r\n  \"email\": \"joan@example.com\",\r\n  \"password\": \"Password123\",\r\n  \"telefon\": \"600123456\"\r\n}",
              "options": {
