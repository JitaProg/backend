        {
          "name": "Renovar Tokens (Refresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Retorna un nou parell de tokens\", () => {",
                  "    pm.expect(body.data.accessToken).to.be.a(\"string\");",
                  "    pm.expect(body.data.refreshToken).to.be.a(\"string\");",
                  "});",
                  "pm.collectionVariables.set(\"refreshTokenAnterior\", pm.collectionVariables.get(\"refreshToken\"));",
                  "pm.collectionVariables.set(\"accessToken\", body.data.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", body.data.refreshToken);",
                  "pm.collectionVariables.set(\"token\", body.data.accessToken);"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"refreshToken\": \"{{refreshToken}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "refresh"
              ]
            }
          },
          "response": []
